# Mixpanel project token. Analytics silently disables itself if this is
# unset -- the app works normally either way. See src/app/services/analytics.ts.
VITE_MIXPANEL_TOKEN=

# Set to "true" to enable analytics on localhost for testing. Analytics is
# skipped on localhost by default even when VITE_MIXPANEL_TOKEN is set.
VITE_MIXPANEL_DEBUG=
